	"semanticHighlighting": true,
	"semanticTokenColors": {
		"namespace": { "foreground": "#861194" },
		"variable": { "foreground": "#238f8f" },
		"variable.defaultLibrary": { "foreground": "#861194" },
		"typeParameter": { "foreground": "#238f8f" },
		"type": { "foreground": "#080808" },
		"type.defaultLibrary": { "fontStyle": "italic" },
		"interface": { "foreground": "#080808" },
		"interface.defaultLibrary": { "fontStyle": "italic" },
		"parameter": { "foreground": "#080808", "fontStyle": "underline" },
		"class": { "foreground": "#0133b3" },
		"class.declaration": { "foreground": "#080808" },
		"class.defaultLibrary": { "foreground": "#861194" },
		"property": { "foreground": "#861194" },
		"property.static": { "fontStyle": "italic" },
		"method": { "foreground": "#914C07" },
		"method.static": { "foreground": "#006279", "fontStyle": "italic" }
	},
	"tokenColors": [
		{ "scope": ["comment"], "settings": { "foreground": "#8c8c8c", "fontStyle": "italic" } },
		{ "scope": ["keyword", "storage.type", "storage.modifier", "constant.language", "constant.character.escape", "entity.name.tag", "entity.name.command"], "settings": { "foreground": "#0133b3" } },
		{ "scope": ["string", "string.quoted"], "settings": { "foreground": "#077d18" } },
		{ "scope": ["constant.numeric"], "settings": { "foreground": "#1750eb" } },
		{ "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#006279" } },
		{ "scope": ["entity.name.type.class", "entity.name.type.interface", "entity.name.type.enum", "entity.name.type", "support.class"], "settings": { "foreground": "#080808" } },
		{ "scope": ["variable", "variable.other", "variable.parameter"], "settings": { "foreground": "#238f8f" } },
		{ "scope": ["variable.other.property", "entity.name.constant", "variable.other.enummember"], "settings": { "foreground": "#861194" } },
		{ "scope": ["keyword.operator"], "settings": { "foreground": "#080808" } },
		{ "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#174ad4" } },
		{ "scope": ["string.other.link"], "settings": { "foreground": "#016dcc", "fontStyle": "underline" } },
		{ "scope": ["storage.type.annotation", "entity.name.type.annotation"], "settings": { "foreground": "#9e880d" } },
		{ "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
		{ "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
		{ "scope": ["invalid"], "settings": { "foreground": "#f50000" } }
	]
}
