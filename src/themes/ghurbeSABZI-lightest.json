	"semanticHighlighting": true,
	"semanticTokenColors": {
		"namespace": { "foreground": "#7a1f8f" },
		"variable": { "foreground": "#005050" },
		"variable.defaultLibrary": { "foreground": "#7a1f8f" },
		"typeParameter": { "foreground": "#005050" },
		"type": { "foreground": "#151a12" },
		"type.defaultLibrary": { "fontStyle": "italic" },
		"interface": { "foreground": "#151a12" },
		"interface.defaultLibrary": { "fontStyle": "italic" },
		"parameter": { "foreground": "#151a12", "fontStyle": "underline" },
		"class": { "foreground": "#002080" },
		"class.declaration": { "foreground": "#151a12" },
		"class.defaultLibrary": { "foreground": "#7a1f8f" },
		"property": { "foreground": "#7a1f8f" },
		"property.static": { "fontStyle": "italic" },
		"method": { "foreground": "#5e3300" },
		"method.static": { "foreground": "#003d4a", "fontStyle": "italic" },
		"enum": { "foreground": "#5e4d00" },
		"enumMember": { "foreground": "#7a1f8f" },
		"event": { "foreground": "#5e3300" },
		"function": { "foreground": "#5e3300" },
		"macro": { "foreground": "#5e3300" },
		"label": { "foreground": "#005050" },
		"comment": { "foreground": "#4a4f45" },
		"string": { "foreground": "#145000" },
		"keyword": { "foreground": "#002080" },
		"number": { "foreground": "#003380" },
		"regexp": { "foreground": "#145000" },
		"operator": { "foreground": "#151a12" },
		"decorator": { "foreground": "#5e5528" },
		"annotation": { "foreground": "#5e5528" }
	},
	"tokenColors": [
		{ "scope": ["comment"], "settings": { "foreground": "#4a4f45", "fontStyle": "italic" } },
		{ "scope": ["keyword", "storage.type", "storage.modifier", "constant.language", "constant.character.escape", "entity.name.tag", "entity.name.command"], "settings": { "foreground": "#002080" } },
		{ "scope": ["string", "string.quoted"], "settings": { "foreground": "#145000" } },
		{ "scope": ["constant.numeric"], "settings": { "foreground": "#003380" } },
		{ "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#003d4a" } },
		{ "scope": ["entity.name.type.class", "entity.name.type.interface", "entity.name.type.enum", "entity.name.type", "support.class"], "settings": { "foreground": "#151a12" } },
		{ "scope": ["variable", "variable.other", "variable.parameter"], "settings": { "foreground": "#005050" } },
		{ "scope": ["variable.other.property", "entity.name.constant", "variable.other.enummember"], "settings": { "foreground": "#7a1f8f" } },
		{ "scope": ["keyword.operator"], "settings": { "foreground": "#151a12" } },
		{ "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#002080" } },
		{ "scope": ["string.other.link"], "settings": { "foreground": "#003d80", "fontStyle": "underline" } },
		{ "scope": ["storage.type.annotation", "entity.name.type.annotation"], "settings": { "foreground": "#5e5528" } },
		{ "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
		{ "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
		{ "scope": ["invalid"], "settings": { "foreground": "#8a2828" } }
	]
}
