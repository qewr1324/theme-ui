	"semanticHighlighting": true,
	"semanticTokenColors": {
		"class": "#A9B7C6",
		"enum": "#A9B7C6",
		"interface": "#A9B7C6",
		"struct": "#A9B7C6",
		"typeParameter": "#CC7832",
		"type": "#CC7832",
		"parameter": {
			"foreground": "#A9B7C6",
			"fontStyle": "underline"
		},
		"variable": "#A9B7C6",
		"property": "#9876AA",
		"enumMember": "#9876AA",
		"event": "#FFC66D",
		"method": "#FFC66D",
		"function": "#FFC66D",
		"macro": "#FFC66D",
		"label": "#9876AA",
		"comment": "#808080",
		"string": "#6A8759",
		"keyword": "#CC7832",
		"number": "#6897BB",
		"regexp": "#6A8759",
		"operator": "#A9B7C6",
		"namespace": "#CC7832",
		"decorator": "#CC7832",
		"annotation": "#BBB529"
	},
	"tokenColors": [
		{
			"scope": ["comment"],
			"settings": { "foreground": "#808080" }
		},
		{
			"scope": ["comment.block.documentation"],
			"settings": { "foreground": "#629755", "fontStyle": "italic" }
		},
		{
			"scope": ["storage.type.primitive.java", "storage.type.java", "keyword.type.var.java", "storage.modifier.java", "keyword.control.java", "keyword.other.import.java", "keyword.other.package.java", "keyword", "storage.type", "storage.modifier", "constant.language", "constant.character.escape"],
			"settings": { "foreground": "#CC7832" }
		},
		{
			"scope": ["keyword.operator.comparison.java", "keyword.operator.assignment.java", "keyword.operator.arithmetic.java", "keyword.operator.logical.java", "keyword.operator"],
			"settings": { "foreground": "#A9B7C6" }
		},
		{
			"scope": ["entity.name.type.class.java", "entity.name.type.interface.java", "entity.name.type.enum.java", "entity.name.type.annotation.java", "entity.name.type.class", "entity.name.type.interface", "entity.name.type.enum", "support.class"],
			"settings": { "foreground": "#A9B7C6" }
		},
		{
			"scope": ["entity.name.function.java", "support.function.java", "entity.name.function", "support.function"],
			"settings": { "foreground": "#FFC66D" }
		},
		{
			"scope": ["variable.parameter.java", "variable.other.object.java", "variable.other.enummember.java", "variable.other.java", "variable.parameter", "variable.other.object", "variable.other.enummember", "variable.other", "variable"],
			"settings": { "foreground": "#9876AA" }
		},
		{
			"scope": ["constant.other.enum.java", "constant.variable.java", "constant.other.java", "constant.other.enum", "constant.variable"],
			"settings": { "foreground": "#9876AA" }
		},
		{
			"scope": ["string.quoted.double.java", "string.quoted.single.java", "punctuation.definition.string.begin.java", "punctuation.definition.string.end.java", "string.quoted.double", "string.quoted.single", "string.quoted.triple", "string.interpolated", "string"],
			"settings": { "foreground": "#6A8759" }
		},
		{
			"scope": ["constant.character.escape.java", "constant.character.escape"],
			"settings": { "foreground": "#CC7832" }
		},
		{
			"scope": ["constant.numeric.decimal.java", "constant.numeric.hex.java", "constant.numeric.binary.java", "constant.numeric.float.java", "constant.numeric"],
			"settings": { "foreground": "#6897BB" }
		},
		{
			"scope": ["storage.type.annotation.java", "punctuation.definition.annotation.java", "entity.name.type.annotation.java", "meta.annotation.java", "storage.type.annotation", "entity.name.type.annotation"],
			"settings": { "foreground": "#BBB529" }
		},
		{
			"scope": ["entity.name.tag.xml", "entity.name.tag.html", "entity.name.tag"],
			"settings": { "foreground": "#E8BF6A" }
		},
		{
			"scope": ["entity.other.attribute-name.xml", "entity.other.attribute-name.html", "entity.other.attribute-name"],
			"settings": { "foreground": "#BABABA" }
		},
		{
			"scope": ["punctuation.definition.tag.xml", "punctuation.definition.tag.html", "punctuation.definition.tag"],
			"settings": { "foreground": "#808080" }
		},
		{
			"scope": ["constant.character"],
			"settings": { "foreground": "#A9B7C6" }
		},
		{
			"scope": ["keyword.other.package.java", "keyword.other.import.java", "storage.modifier.package.java", "storage.modifier.import.java"],
			"settings": { "foreground": "#CC7832" }
		},
		{
			"scope": ["entity.name.type.package.java", "entity.name.type.import.java"],
			"settings": { "foreground": "#9876AA" }
		},
		{
			"scope": ["markup.italic"],
			"settings": { "fontStyle": "italic" }
		},
		{
			"scope": ["markup.bold"],
			"settings": { "fontStyle": "bold" }
		},
		{
			"scope": ["invalid"],
			"settings": { "foreground": "#f75464" }
		}
	]
}
