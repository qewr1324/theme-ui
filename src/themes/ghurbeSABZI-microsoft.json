{
	"$schema": "vscode://schemas/color-theme",
	"type": "dark",
	"colors": {
		"editor.background": "#1E1E1E",
		"editor.foreground": "#D4D4D4",
		"editor.inactiveSelectionBackground": "#3A3D41",
		"editorIndentGuide.background1": "#404040",
		"editor.selectionHighlightBackground": "#ADD6FF26",
		"editor.lineHighlightBackground": "#2B2B2B",
		"editor.selectionBackground": "#264F78",
		"editor.findMatchBackground": "#515C6A",
		"editor.findMatchHighlightBackground": "#EA5C0055",
		"editorBracketMatch.background": "#0064001a",
		"editorBracketMatch.border": "#888888",
		"editorGutter.background": "#1E1E1E",
		"editorGutter.addedBackground": "#587C0C",
		"editorGutter.modifiedBackground": "#0C7D9D",
		"editorGutter.deletedBackground": "#94151B",
		"editorLineNumber.foreground": "#858585",
		"editorLineNumber.activeForeground": "#C6C6C6",
		"editorCursor.foreground": "#AEAFAD",
		"editorWhitespace.foreground": "#3B3A32",
		"activityBar.background": "#333333",
		"activityBar.foreground": "#FFFFFF",
		"activityBar.inactiveForeground": "#858585",
		"activityBar.border": "#3E3E3E",
		"activityBarBadge.background": "#007ACC",
		"activityBarBadge.foreground": "#FFFFFF",
		"sideBar.background": "#252526",
		"sideBar.foreground": "#CCCCCC",
		"sideBar.border": "#3E3E3E",
		"sideBarSectionHeader.background": "#252526",
		"sideBarSectionHeader.foreground": "#CCCCCC",
		"sideBarSectionHeader.border": "#3E3E3E",
		"statusBar.background": "#007ACC",
		"statusBar.foreground": "#FFFFFF",
		"statusBar.border": "#007ACC",
		"statusBar.noFolderBackground": "#68217A",
		"statusBar.noFolderForeground": "#FFFFFF",
		"statusBar.debuggingBackground": "#CC6633",
		"statusBar.debuggingForeground": "#FFFFFF",
		"statusBarItem.activeBackground": "#FFFFFF2E",
		"statusBarItem.hoverBackground": "#FFFFFF1A",
		"titleBar.activeBackground": "#3C3C3C",
		"titleBar.activeForeground": "#FFFFFF",
		"titleBar.inactiveBackground": "#3C3C3C",
		"titleBar.inactiveForeground": "#CCCCCC",
		"terminal.background": "#1E1E1E",
		"terminal.foreground": "#D4D4D4",
		"terminalCursor.foreground": "#AEAFAD",
		"terminal.selectionBackground": "#FFFFFF40",
		"panel.background": "#1E1E1E",
		"panel.border": "#3E3E3E",
		"panelTitle.activeBorder": "#007ACC",
		"panelTitle.activeForeground": "#FFFFFF",
		"panelTitle.inactiveForeground": "#CCCCCC",
		"input.background": "#3C3C3C",
		"input.foreground": "#CCCCCC",
		"input.border": "#3E3E3E",
		"inputOption.activeBorder": "#007ACC",
		"dropdown.background": "#3C3C3C",
		"dropdown.foreground": "#F0F0F0",
		"dropdown.border": "#3E3E3E",
		"button.background": "#0E639C",
		"button.foreground": "#FFFFFF",
		"button.hoverBackground": "#1177BB",
		"badge.background": "#4D4D4D",
		"badge.foreground": "#FFFFFF",
		"scrollbar.shadow": "#00000033",
		"scrollbarSlider.background": "#79797966",
		"scrollbarSlider.hoverBackground": "#646464B3",
		"scrollbarSlider.activeBackground": "#BFBFBF99",
		"list.activeSelectionBackground": "#094771",
		"list.activeSelectionForeground": "#FFFFFF",
		"list.inactiveSelectionBackground": "#37373D",
		"list.hoverBackground": "#2A2D2E",
		"list.dropBackground": "#383B3D",
		"list.highlightForeground": "#0097FB",
		"list.focusHighlightForeground": "#0097FB",
		"notificationCenterHeader.background": "#303031",
		"notifications.background": "#252526",
		"notifications.foreground": "#CCCCCC",
		"notifications.border": "#303031",
		"notificationLink.foreground": "#3794FF",
		"gitDecoration.addedResourceForeground": "#81B88B",
		"gitDecoration.modifiedResourceForeground": "#E2B08D",
		"gitDecoration.deletedResourceForeground": "#C74E39",
		"gitDecoration.untrackedResourceForeground": "#73C991",
		"gitDecoration.ignoredResourceForeground": "#8C8C8C",
		"gitDecoration.conflictingResourceForeground": "#E4676B",
		"editorBracketHighlight.foreground1": "#FFD700",
		"editorBracketHighlight.foreground2": "#DA70D6",
		"editorBracketHighlight.foreground3": "#179FFF"
	},
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"class": "#4EC9B0",
		"enum": "#4EC9B0",
		"interface": "#4EC9B0",
		"typeParameter": "#569CD6",
		"type": "#569CD6",
		"parameter": {
			"foreground": "#9CDCFE",
			"fontStyle": "underline"
		},
		"variable": "#9CDCFE",
		"property": "#9CDCFE",
		"method": "#DCDCAA",
		"function": "#DCDCAA",
		"keyword": "#569CD6",
		"number": "#B5CEA8",
		"string": "#CE9178",
		"comment": "#6A9955",
		"operator": "#D4D4D4",
		"namespace": "#569CD6",
		"annotation": "#8781c1"
	},
	"tokenColors": [
		{
			"name": "Comment",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#6A9955"
			}
		},
		{
			"name": "Keywords",
			"scope": ["keyword", "keyword.control", "keyword.operator.new", "keyword.operator.expression", "storage.type", "storage.modifier", "support.type"],
			"settings": {
				"foreground": "#569CD6"
			}
		},
		{
			"name": "Control Keywords",
			"scope": ["keyword.control", "keyword.other.import", "keyword.other.package"],
			"settings": {
				"foreground": "#c586c0"
			}
		},
		{
			"name": "Strings",
			"scope": ["string", "string.quoted", "string.template"],
			"settings": {
				"foreground": "#8c695f"
			}
		},
		{
			"name": "String Punctuation",
			"scope": ["punctuation.definition.string.begin", "punctuation.definition.string.end"],
			"settings": {
				"foreground": "#8c695f"
			}
		},
		{
			"name": "Character Escape",
			"scope": ["constant.character.escape"],
			"settings": {
				"foreground": "#EBCB8B"
			}
		},
		{
			"name": "Functions",
			"scope": ["entity.name.function", "support.function"],
			"settings": {
				"foreground": "#dcdcaada"
			}
		},
		{
			"name": "Classes",
			"scope": ["entity.name.type.class", "entity.name.type.interface", "entity.name.type.enum", "support.class"],
			"settings": {
				"foreground": "#4EC9B0"
			}
		},
		{
			"name": "Variables",
			"scope": ["variable", "variable.parameter", "variable.other.object", "variable.other"],
			"settings": {
				"foreground": "#9CDCFE"
			}
		},
		{
			"name": "Constants",
			"scope": ["constant.other.enum", "constant.variable", "constant.other"],
			"settings": {
				"foreground": "#4FC1FF"
			}
		},
		{
			"name": "Numbers",
			"scope": ["constant.numeric"],
			"settings": {
				"foreground": "#B5CEA8"
			}
		},
		{
			"name": "Operators",
			"scope": ["keyword.operator", "keyword.operator.comparison", "keyword.operator.assignment", "keyword.operator.arithmetic", "keyword.operator.logical"],
			"settings": {
				"foreground": "#D4D4D4"
			}
		},
		{
			"name": "Annotations",
			"scope": ["storage.type.annotation", "punctuation.definition.annotation", "entity.name.type.annotation", "meta.annotation"],
			"settings": {
				"foreground": "#8781c1"
			}
		},
		{
			"name": "Package/Import Keywords",
			"scope": ["keyword.other.package", "keyword.other.import", "storage.modifier.package", "storage.modifier.import"],
			"settings": {
				"foreground": "#569cd6c7"
			}
		},
		{
			"name": "Package/Import Names",
			"scope": ["entity.name.type.package", "entity.name.type.import"],
			"settings": {
				"foreground": "#9CDCFE"
			}
		},
		{
			"name": "HTML/XML Tags",
			"scope": ["entity.name.tag", "entity.name.tag.xml", "entity.name.tag.html"],
			"settings": {
				"foreground": "#569CD6"
			}
		},
		{
			"name": "HTML/XML Attributes",
			"scope": ["entity.other.attribute-name", "entity.other.attribute-name.html", "entity.other.attribute-name.xml"],
			"settings": {
				"foreground": "#9CDCFE"
			}
		},
		{
			"name": "HTML/XML Punctuation",
			"scope": ["punctuation.definition.tag", "punctuation.definition.tag.xml", "punctuation.definition.tag.html"],
			"settings": {
				"foreground": "#808080"
			}
		},
		{
			"name": "JSON Property Names",
			"scope": ["support.type.property-name.json"],
			"settings": {
				"foreground": "#9CDCFE"
			}
		},
		{
			"name": "JSON Strings",
			"scope": ["string.quoted.double.json", "string.quoted.double.json punctuation"],
			"settings": {
				"foreground": "#8c695f"
			}
		},
		{
			"name": "Markup Bold",
			"scope": ["markup.bold"],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markup Italic",
			"scope": ["markup.italic"],
			"settings": {
				"fontStyle": "italic"
			}
		}
	]
}
