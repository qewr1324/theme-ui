	"semanticHighlighting": true,
	"semanticTokenColors": {
		"namespace": {
			"foreground": "#acc998"
		},
		"variable": {
			"foreground": "#748867"
		},
		"variable.defaultLibrary": {
			"foreground": "#acc998"
		},
		"parameter": {
			"foreground": "#cccccc",
			"fontStyle": "underline"
		},
		"typeParameter": {
			"foreground": "#acc998"
		},
		"type": {
			"foreground": "#acc998"
		},
		"interface": {
			"foreground": "#acc998"
		},
		"class": {
			"foreground": "#8c823d"
		},
		"property": {
			"foreground": "#748867"
		},
		"method": {
			"foreground": "#acc998"
		}
	},
	"tokenColors": [
		{
			"name": "Comment",
			"scope": ["comment"],
			"settings": {
				"foreground": "#608b4c"
			}
		},
		{
			"name": "Keywords",
			"scope": ["keyword", "keyword.operator.new", "keyword.operator.expression", "storage", "storage.type", "support.type", "constant.language", "variable.language.this"],
			"settings": {
				"foreground": "#569CD6"
			}
		},
		{
			"name": "Strings",
			"scope": ["string", "punctuation.definition.string"],
			"settings": {
				"foreground": "#8c695f"
			}
		},
		{
			"name": "Functions",
			"scope": ["entity.name.function", "support.function"],
			"settings": {
				"foreground": "#dcdcaada"
			}
		},
		{
			"name": "Types & Classes",
			"scope": ["entity.name.type.class", "entity.name.type.interface", "entity.name.type.enum", "support.class"],
			"settings": {
				"foreground": "#4EC9B0"
			}
		},
		{
			"name": "Numbers",
			"scope": ["constant.numeric"],
			"settings": {
				"foreground": "#B5CEA8"
			}
		},
		{
			"name": "Variables",
			"scope": ["variable.parameter", "variable.other.object", "variable.other"],
			"settings": {
				"foreground": "#9CDCFE"
			}
		},
		{
			"name": "Constants",
			"scope": ["constant.other.enum", "constant.variable"],
			"settings": {
				"foreground": "#4FC1FF"
			}
		},
		{
			"name": "Character Escape",
			"scope": ["constant.character.escape"],
			"settings": {
				"foreground": "#EBCB8B"
			}
		},
		{
			"name": "Annotations",
			"scope": ["storage.type.annotation", "punctuation.definition.annotation", "entity.name.type.annotation", "meta.annotation"],
			"settings": {
				"foreground": "#8781c1"
			}
		},
		{
			"name": "Package & Import Keywords",
			"scope": ["keyword.other.package", "keyword.other.import", "storage.modifier.package", "storage.modifier.import"],
			"settings": {
				"foreground": "#569cd6c7"
			}
		},
		{
			"name": "Package & Import Names",
			"scope": ["entity.name.type.package", "entity.name.type.import"],
			"settings": {
				"foreground": "#9CDCFE"
			}
		},
		{
			"name": "Operators",
			"scope": ["keyword.operator", "keyword.operator.comparison", "keyword.operator.assignment", "keyword.operator.arithmetic", "keyword.operator.logical"],
			"settings": {
				"foreground": "#D4D4D4"
			}
		},
		{
			"name": "HTML/XML Tags",
			"scope": ["entity.name.tag", "entity.name.tag.xml", "entity.name.tag.html"],
			"settings": {
				"foreground": "#569CD6"
			}
		},
		{
			"name": "HTML/XML Attributes",
			"scope": ["entity.other.attribute-name", "entity.other.attribute-name.html", "entity.other.attribute-name.xml"],
			"settings": {
				"foreground": "#9CDCFE"
			}
		},
		{
			"name": "CSS Classes",
			"scope": ["entity.other.attribute-name.class.css"],
			"settings": {
				"foreground": "#DCDCAA"
			}
		},
		{
			"name": "CSS Properties",
			"scope": ["support.type.property-name.css"],
			"settings": {
				"foreground": "#9CDCFE"
			}
		},
		{
			"name": "Punctuation",
			"scope": ["punctuation.definition.tag", "punctuation.definition.tag.xml", "punctuation.definition.tag.html"],
			"settings": {
				"foreground": "#808080"
			}
		},
		{
			"name": "Bracket Pair 1",
			"scope": ["meta.bracket.1"],
			"settings": {
				"foreground": "#81a1c16b"
			}
		}
	]
}
