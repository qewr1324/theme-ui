{
	"name": "theme-ui",
	"type": "module",
	"displayName": "Theme UI",
	"description": "🧶 Theme UI - Theme UI is an extension for creating and building your own custom theme for 💠 VSCode. ",
	"version": "1.36.52",
	"private": false,
	"publisher": "GhurbeSABZI",
	"packageManager": "bun@1.3.14",
	"author": "GhurbeSABZI <naiad.arts.studio@gmail.com>",
	"icon": "res/theme-icon-big.png",
	"license": "MIT",
	"homepage": "https://github.com/qewr1324/theme-ui#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/qewr1324/theme-ui"
	},
	"bugs": {
		"url": "https://github.com/qewr1324/theme-ui/issues"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"keywords": [
		"theme-ui",
		"theme",
		"darkula",
		"lightula",
		"ghurbeSABZI-darkula",
		"ghurbeSABZI-lightula"
	],
	"categories": [
		"Themes",
		"Other"
	],
	"galleryBanner": {
		"color": "#0F1A1C",
		"theme": "dark"
	},
	"preview": false,
	"qna": "marketplace",
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension.cjs",
	"contributes": {
		"themes": [
			{
				"label": "Intellij Darkula Classic",
				"uiTheme": "vs-dark",
				"path": "./src/themes/intellij-darkula-classic.json"
			},
			{
				"label": "Intellij Darkula Modern",
				"uiTheme": "vs-dark",
				"path": "./src/themes/intellij-darkula-modern.json"
			},
			{
				"label": "Intellij Lightula",
				"uiTheme": "vs",
				"path": "./src/themes/intellij-lightula.json"
			},
			{
				"label": "Microsoft Dark",
				"uiTheme": "vs-dark",
				"path": "./src/themes/microsoft-dark.json"
			},
			{
				"label": "Microsoft Light",
				"uiTheme": "vs",
				"path": "./src/themes/microsoft-light.json"
			},
			{
				"label": "GhurbeSABZI Darkest",
				"uiTheme": "vs-dark",
				"path": "./src/themes/ghurbeSABZI-darkest.json"
			},
			{
				"label": "GhurbeSABZI Lightest",
				"uiTheme": "vs",
				"path": "./src/themes/ghurbeSABZI-lightest.json"
			}
		],
		"commands": [
			{
				"command": "theme-ui.showThemeMenu",
				"title": "Show Theme Menu"
			},
			{
				"command": "theme-ui.createTheme",
				"title": "Create New Theme"
			},
			{
				"command": "theme-ui.editTheme",
				"title": "Edit Theme"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "bun run build",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"build": "tsdown src/extension.ts --external vscode",
		"dev": "bun run build --watch --sourcemap",
		"prepare": "echo 'Skipping update'",
		"update": "echo 'Skipping vscode-ext-gen'",
		"lint": "eslint .",
		"test": "vitest",
		"typecheck": "tsc --noEmit",
		"release": "bumpp",
		"ext:package": "vsce package --no-dependencies",
		"ext:publish": "vsce publish --no-dependencies"
	},
	"devDependencies": {
		"@types/vscode": "^1.85.0",
		"@types/node": "^20.0.0",
		"typescript": "^5.3.0",
		"@antfu/eslint-config": "^6.7.3",
		"@antfu/ni": "^28.0.0",
		"@vscode/vsce": "^3.7.1",
		"bumpp": "^10.3.2",
		"eslint": "^9.39.2",
		"ovsx": "^0.10.7",
		"reactive-vscode": "^1.0.0-beta.2",
		"taze": "^19.9.2",
		"tsdown": "^0.19.0-beta.3",
		"vite": "^7.3.0",
		"vitest": "^4.0.16",
		"vscode-ext-gen": "^1.5.1",
		"vsxpub": "^0.1.2"
	}
}
